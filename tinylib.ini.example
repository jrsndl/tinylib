# Copy to tinylib.ini in this folder (beside menu.py and worker.py).
# Only administrators should be able to write this folder and the security file.
# See docs/security.md.

[tinylib]
# Users, groups, libraries and grants. Artists: read. Admins: write.
# Relative paths resolve beside this file. Environment variables are not expanded.
security = //studio/pipeline/tinylib/security.json

# Optional default browser configuration (tools, colour spaces, profiles, Deadline).
# TINYLIB_CONFIG or launch.py --config can still choose another browser config;
# nothing can choose another security file.
config = //studio/pipeline/tinylib/studio.json

[tools]
# Executables TinyLib runs, for the browser and the farm worker. These override any
# "tools" in a browser configuration. A bare name is looked up on PATH; a relative
# path resolves beside this file. Leave a line out to use the bare name.
ffmpeg = ffmpeg
ffprobe = ffprobe
ffplay = ffplay
oiiotool = oiiotool
vfx_transcode = vfx-transcode
# AYON launcher console, for the Publish to AYON action outside an AYON-launched Nuke.
# ayon_console = C:/Program Files/Ynput/AYON 1.6.3/ayon_console.exe
# Players and other programs for actions, e.g. Open in Player lists every tool here except
# TinyLib's own (ffmpeg, ffprobe, ffplay, oiiotool, vfx_transcode, ocio, ayon_console).
# rv = C:/Program Files/Autodesk/RV-2025.0.0/bin/rv.exe
# djv = C:/Program Files/DJV2/bin/djv.exe
# mrv2 = C:/Program Files/mrv2-v1.4.0/bin/mrv2.exe
# OCIO config for generated previews; overrides each profile's "ocio_config".
# A path, or a built-in config such as ocio://studio-config-latest.
# ocio = //studio/pipeline/ocio/aces_1.2/config.ocio

# Local development: use the repository's own configuration as the security file,
# then run:  python -m tinylib.admin add-user <your account>
# security = config/studio.json
# config = config/studio.json
